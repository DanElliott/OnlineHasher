@page "/"

    <EditForm Model="@hasherModel" OnSubmit="HandleSubmit">

        <label for="password">Password</label>
        <InputText type="text" id="password" name="password" @bind-Value="hasherModel.Password" placeholder="Password" autofocus />
        <br />

        <label for="salt">Salt (optional)</label>
        <InputText type="text" id="salt" name="salt" @bind-Value="hasherModel.Salt" placeholder="Salt" />
        <br />

        <input type="submit" value="Generate hash" />
    </EditForm>

@switch (result)
{
    case HashResult.Success success:
        <label for="hash">Hash</label>
        <output contenteditable="true" id="hash">@success.Hash</output>
        break;
    case HashResult.Failure failure:
        <div id="error" role="alert">@failure.Error</div>
        break;
}

@code {
    private HasherModel hasherModel = new HasherModel();
    private HashResult result;

    private void HandleSubmit()
    {
        result = PasswordHasher.Hash(hasherModel.Password, hasherModel.Salt);
    }

    public class HasherModel
    {
        public string Password { get; set; }

        public string Salt { get; set; }
    }
}